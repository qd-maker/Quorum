# Quorum 环境变量模板
# 复制为 .env 并填写你的 API 配置

# ─── 统一 API 中转站（支持 OpenAI 兼容格式） ───
API_BASE_URL=https://yunwu.ai/v1
API_KEY=sk-your-api-key-here

# ─── Supabase（必填：认证 + 数据库） ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── CORS 允许的源（逗号分隔，生产环境需改为实际域名） ───
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── 搜索服务（可选，提升联网搜索质量） ───
TAVILY_API_KEY=tvly-your-tavily-key

# ─── Demo 模式（公开演示用，可选） ───
# 启用后，AuthPage 会显示「免登录立即体验」按钮，访客无需注册即可使用 chat/discuss
# 但 history、config 等敏感端点仍需登录访问
DEMO_MODE=false
DEMO_RATE_PER_MINUTE=3
